# Per-container args — injected by Modal at spawn time (NOT stored in Secret)
DARWIN_ID=00000000-0000-0000-0000-000000000000
DARWIN_SESSION_ID=00000000-0000-0000-0000-000000000000
DARWIN_AGENT_JWT=eyJ...
DARWIN_BACKEND_URL=http://localhost:8000
# Optional: httpx timeouts (seconds) for God Layer calls — raise READ if Fly cold starts exceed 60s.
# DARWIN_BACKEND_TIMEOUT_CONNECT=10
# DARWIN_BACKEND_TIMEOUT_READ=90
# DARWIN_BACKEND_TIMEOUT_WRITE=30
# DARWIN_BACKEND_TIMEOUT_POOL=10

# Injected as the first user message when the agent wakes up.
# On first spawn this is typically the creator's goal; on subsequent wakes
# it contains the outcome of the event the agent was waiting for.
DARWIN_WAKE_PROMPT="Fresh start — no prior history."
DARWIN_VCC_REF=vcc_ref_local

# Hermes HOME — points Hermes at the Modal Volume (or local dev dir)
HERMES_HOME=/tmp/hermes_home_dev

# === Modal Secret (darwin-agent-secrets) ===
# These are injected into every running container — keep to a minimum.
# OpenRouter is the only LLM API surface for Hermes (chat + compressed context + optional media).
OPENROUTER_API_KEY=sk-or-...
# Optional: primary slug when Modal runs Hermes via AIAgent fallback (overrides config.yaml model.default if set).
OPENROUTER_MODEL=
OPENROUTER_DEFAULT_MODEL=
# Optional: cap completion tokens for AIAgent fallback (overrides config.yaml model.max_tokens).
OPENROUTER_MAX_TOKENS=4096
# Optional: set to 1/true so Hermes prints tool progress to stderr (noisy but visible in Modal Logs).
DARWIN_HERMES_VERBOSE=
# Optional: override default slug used when delegate_task omits per-task model
OPENROUTER_DEFAULT_TASK_MODEL=anthropic/claude-haiku-4.5

# Browserbase (stealth browser sessions with session persistence)
BROWSERBASE_API_KEY=bb_live_...
BROWSERBASE_PROJECT_ID=...

# Browser-use Cloud — stealth fallback (Layer 3).  Set this key to enable
# automatic retry via Browser-use when Browserbase is blocked by Cloudflare/Datadome.
# See darwin-docs/engineering/agent/darwin-browsing.md for the full tradeoff analysis.
BROWSER_USE_API_KEY=bu_...
# Workaround for Hermes issue #11020 — prevents per-turn cleanup from killing
# persistent Browser-use sessions.  Keep until the upstream bug is resolved.
BROWSER_PERSIST_BETWEEN_TURNS=1
BROWSER_INACTIVITY_TIMEOUT=2592000

# Langfuse (replaces LangSmith — enabled via Hermes plugin)
HERMES_LANGFUSE_PUBLIC_KEY=pk-lf-...
HERMES_LANGFUSE_SECRET_KEY=sk-lf-...
HERMES_LANGFUSE_BASE_URL=https://cloud.langfuse.com

# === Local dev / CI only — NOT in Modal Secret ===
# Modal credentials are only needed to run `modal deploy` from your machine.
# Never put these in darwin-agent-secrets (they'd be injected into every container).
MODAL_TOKEN_ID=ak-...
MODAL_TOKEN_SECRET=as-...
