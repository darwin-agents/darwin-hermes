# Per-container args — injected by Modal at spawn time (NOT stored in Secret)
DARWIN_ID=00000000-0000-0000-0000-000000000000
DARWIN_SESSION_ID=00000000-0000-0000-0000-000000000000
DARWIN_AGENT_JWT=eyJ...
DARWIN_BACKEND_URL=http://localhost:8000
DARWIN_WAKE_PROMPT="Fresh start — no prior history."
DARWIN_VCC_REF=vcc_ref_local

# Hermes HOME — points Hermes at the Modal Volume (or local dev dir)
HERMES_HOME=/tmp/hermes_home_dev

# === Modal Secret (darwin-agent-secrets) ===
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-...
AGENT_JWT_SECRET=...

# Browserbase (stealth browser sessions with session persistence)
BROWSERBASE_API_KEY=bb_live_...
BROWSERBASE_PROJECT_ID=...

# Browser-use Cloud — stealth fallback (Layer 3).  Set this key to enable
# automatic retry via Browser-use when Browserbase is blocked by Cloudflare/Datadome.
# See darwin-docs/engineering/agent/darwin-browsing.md for the full tradeoff analysis.
BROWSER_USE_API_KEY=bu_live_...
# Workaround for Hermes issue #11020 — prevents per-turn cleanup from killing
# persistent Browser-use sessions.  Keep until the upstream bug is resolved.
BROWSER_PERSIST_BETWEEN_TURNS=1
BROWSER_INACTIVITY_TIMEOUT=2592000
MODAL_TOKEN_ID=ak-...
MODAL_TOKEN_SECRET=as-...

# Langfuse (replaces LangSmith — enabled via Hermes plugin)
HERMES_LANGFUSE_PUBLIC_KEY=pk-lf-...
HERMES_LANGFUSE_SECRET_KEY=sk-lf-...
HERMES_LANGFUSE_BASE_URL=https://cloud.langfuse.com
